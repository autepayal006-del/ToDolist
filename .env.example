# =============================================================================
# TaskMate Server Environment Variables (.env.example)
# =============================================================================
# Copy this file to `.env` and fill in your confidential credentials.
# NEVER commit your real `.env` file to version control.
# =============================================================================

# Server Port
PORT=3000

# Server Environment ('development' or 'production')
NODE_ENV=development

# Supabase Project URL (Publicly safe)
SUPABASE_URL=https://tyapfcjbwlnkvypdkekw.supabase.co

# Supabase Service Role Key (SERVER-ONLY SECRET - KEEP PRIVATE!)
# How to obtain:
# 1. Go to https://supabase.com/dashboard/project/tyapfcjbwlnkvypdkekw
# 2. In left sidebar, click "Project Settings" (gear icon) -> "API".
# 3. Under "Project API keys", find "service_role" (secret).
# 4. Copy its value and paste below.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Secret string used to cryptographically derive secure owner IDs from session tokens
# Replace with any strong random string (minimum 32 characters)
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars
